# Copy this file to .env (never commit .env).
# Only these three values change when you switch between Ollama and Azure.

# Days 1 to 3: Ollama on your laptop (free). Run `ollama pull llama3.2` first.
MODEL_ENDPOINT=http://localhost:11434/v1
MODEL_NAME=llama3.2
# Ollama ignores the key, but the openai SDK needs a non-empty value.
MODEL_API_KEY=ollama

# From day 4: Azure AI Foundry. Comment out the block above and fill in these.
# MODEL_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
# MODEL_NAME=<your-deployment-name>
# MODEL_API_KEY=<key from the Foundry portal; in CI use the MODEL_API_KEY repo secret>
